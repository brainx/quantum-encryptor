{
  "name": "quantum-encryptor-web",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4001",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && npm run test:api && npm run test:unit",
    "test:api": "node --test scripts/api_client.test.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "ui-smoke": "node scripts/ui_smoke.mjs",
    "ui-native": "node scripts/ui_native_smoke.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "30.1.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  }
}
